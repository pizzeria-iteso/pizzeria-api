{
  "name": "pizzeria-api",
  "version": "0.0.1",
  "description": "Backend del proyecto final de **Infraestructura para el Desarrollo Continuo** (ITESO).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:watch": "vitest",
    "build:node": "esbuild src/node/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.mjs",
    "start:node": "npm run build:node && node --disable-warning=ExperimentalWarning dist/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pizzeria-iteso/pizzeria-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/pizzeria-iteso/pizzeria-api/issues"
  },
  "homepage": "https://github.com/pizzeria-iteso/pizzeria-api#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@sentry/cloudflare": "^11.16.0",
    "@sentry/hono": "^11.16.0",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
