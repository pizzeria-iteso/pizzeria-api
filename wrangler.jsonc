{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pizzeria-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "local",
		"VERSION": "0.0.1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pizzeria-db-dev",
			"database_id": "8e3f886c-ec17-4215-bfa2-a4d04deb1de2"
		}
	]
}